rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "5607ISIL0PMq6HLmzhTxyFa2elY2";
    }
    match /downloads/{downloadId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /siteConfig/{configId} {
      // Public download pages must read the shared unlock actions.
      allow read: if configId == "public" || configId == "unlockLinkSettings";
      // Only the configured admin account may change site settings.
      allow create, update, delete: if isAdmin();
    }
    match /sites/{siteId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
      match /pages/{pageId} {
        allow read, write: if isAdmin();
      }
      match /versions/{versionId} {
        allow read, write: if isAdmin();
      }
      // Public published snapshots are separated from private drafts.
      match /publicPages/{pageId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }
    match /analyticsEvents/{eventId} {
      // Public clients may append narrowly-scoped anonymous usage events; only admin can read them.
      allow create: if request.resource.data.keys().hasOnly(["type", "visitorId", "sessionId", "page", "createdAt", "downloadId"])
        && request.resource.data.type in ["page_view", "heartbeat", "download_click"]
        && request.resource.data.visitorId is string && request.resource.data.visitorId.size() <= 100
        && request.resource.data.sessionId is string && request.resource.data.sessionId.size() <= 100
        && request.resource.data.page is string && request.resource.data.page.size() <= 80
        && request.resource.data.createdAt == request.time
        && (!("downloadId" in request.resource.data) || (request.resource.data.downloadId is string && request.resource.data.downloadId.size() <= 100));
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}