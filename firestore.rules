rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "5607ISIL0PMq6HLmzhTxyFa2elY2";
    }
    match /downloads/{downloadId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /siteConfig/{configId} {
      // Public download pages must read the shared unlock actions.
      allow read: if configId == "public" || configId == "unlockLinkSettings";
      // Only the configured admin account may change site settings.
      allow create, update, delete: if isAdmin();
    }
    match /sites/{siteId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
      match /pages/{pageId} {
        allow read, write: if isAdmin();
      }
      match /versions/{versionId} {
        allow read, write: if isAdmin();
      }
      // Public published snapshots are separated from private drafts.
      match /publicPages/{pageId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}