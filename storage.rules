rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "5607ISIL0PMq6HLmzhTxyFa2elY2";
    }
    match /download-previews/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && userId == request.auth.uid
        && request.resource != null
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches('video/(mp4|webm)');
      allow delete: if isAdmin() && userId == request.auth.uid;
    }
    match /builder-media/{userId}/{fileName} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && userId == request.auth.uid
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if isAdmin() && userId == request.auth.uid;
    }
    match /music-tracks/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && userId == request.auth.uid
        && request.resource != null
        && request.resource.size <= 30 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if isAdmin() && userId == request.auth.uid;
    }
  }
}
